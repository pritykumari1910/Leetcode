class Solution {
public:
    int minSumOfLengths(vector<int>& A, int k) {
        int n = A.size();
        int res = n + 1, sum = 0, j = 0;

        vector<int> dp(n + 1, n);

        for (int i = 0; i < n; i++) {
            sum += A[i];

            while (sum > k)
                sum -= A[j++];

            dp[i + 1] = dp[i];

            if (sum == k) {
                res = min(res, i - j + 1 + dp[j]);
                dp[i + 1] = min(dp[i], i - j + 1);
            }
        }

        return res == n + 1 ? -1 : res;
    }
};
