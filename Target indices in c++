class Solution {
public:
    vector<int> targetIndices(vector<int>& nums, int target) {
        vector<int> res;
        int count = 0;
        int start = 0;

        for(int num : nums) {
            if(num == target) {
                count++;
            }
            if(num < target) {
                start++;
            }
        }

        while(count-- != 0) {
            res.push_back(start++);
        }

        return res;
    }
};
